{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MediaValidation": {
    "AllowedImageTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "MaxImageSizeMb": 150,
    "MaxImagesPerUpload": 10,
    "MaxSvgSizeMb": 1
  },
  "DocumentValidation": {
    "AllowedTypes": [
      "application/pdf",
      "application/msword",
      "application/vnd.openxmlformats-officedocument.wordprocessingml.document"
    ],
    "MaxSizeMb": 10,
    "MaxDocumentsPerUpload": 5
  },
  "UploadSettings": {
  "MaxRequestBodySizeInMB": 100 
}
  
}
