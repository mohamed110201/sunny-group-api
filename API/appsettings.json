{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "MediaValidation": {
    "AllowedImageTypes": [ "image/jpeg", "image/png", "image/webp" ],
    "MaxImageSizeMb": 5,
    "MaxImagesPerUpload": 10,
    "MaxSvgSizeMb": 1
  }
}
